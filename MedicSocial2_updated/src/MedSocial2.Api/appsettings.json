{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "MedSocial2",
    "Audience": "MedSocial2.Clients",
    "SigningKey": "MedSocial2-Development-Signing-Key-Needs-Change",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 14
  },
  "DocumentStorage": {
    "Provider": "Local",
    "Local": {
      "BasePath": "Documents"
    }
  },
  "FileSecurity": {
    "DefaultMaxFileSizeBytes": 50000000,
    "BlockedExtensions": [ ".exe", ".dll", ".com", ".bat", ".cmd", ".ps1", ".sh", ".msi", ".scr" ],
    "ClamAvHost": "",
    "ClamAvPort": 3310,
    "RequireClamAv": false
  },
  "VerificationIntegration": {
    "Enabled": false,
    "Provider": "None"
  },
  "SocialMongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "MedSocial2Social",
    "PublicMediaBaseUrl": ""
  }
}
