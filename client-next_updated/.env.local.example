# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Backend Service Base URLs (for direct API calls outside of rewrites)
NEXT_PUBLIC_AUTH_API_URL=http://localhost:5001
NEXT_PUBLIC_PROFESSIONAL_API_URL=http://localhost:5002
NEXT_PUBLIC_JOB_API_URL=http://localhost:5003
NEXT_PUBLIC_VERIFICATION_API_URL=http://localhost:5004
NEXT_PUBLIC_EMPLOYER_API_URL=http://localhost:5005

# Feature Flags
NEXT_PUBLIC_ENABLE_MESSAGING=true
NEXT_PUBLIC_ENABLE_VIDEO_CALLS=false

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Bypass authentication for development
# set to true to allow any credentials on the login screen and skip the
# round‑trip to the API.  The UI will still set a dummy token in
# localStorage so protected routes work as expected.
NEXT_PUBLIC_BYPASS_AUTH=true

# Environment
NODE_ENV=development
